# Mesh local development environment (copy to .env — never commit real secrets).
# Every secret is read from the environment; these are LOCAL DEV values only.
#
# LOCAL DEVELOPMENT ONLY: the compose stack binds published ports to 127.0.0.1
# (reachable from this machine only) and runs MESH_AUTH_MODE=dev. For ANY
# non-local use you MUST set MESH_AUTH_MODE=production and provide real secrets.

# PostgreSQL (docker compose service credentials)
MESH_POSTGRES_DB=mesh
MESH_POSTGRES_USER=mesh
MESH_POSTGRES_PASSWORD=mesh

# Restricted non-owner DB role password for the API/gateway app connection (M1).
# Migration 0002 creates/updates the mesh_app login role with this password and
# compose wires MESH_APP_DATABASE_URL from it. LOCAL DEV default — in production
# set a strong value.
MESH_APP_DB_PASSWORD=mesh_app

# Host port mapping (published ports bind 127.0.0.1 — see docker-compose.yml).
MESH_API_PORT=8000
MESH_WS_PORT=8081
MESH_FRONTEND_PORT=3001

# Auth mode: dev = development token authenticator (mesh-dev:<workspace-id>);
# production refuses dev tokens (the auth module plugs in the real one).
# Safe as "dev" ONLY because ports are loopback-bound; set "production" for any
# non-local deployment.
MESH_AUTH_MODE=dev
