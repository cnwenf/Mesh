# Mesh local development environment template (copy to .env — never commit real
# secrets). Every secret is REQUIRED by docker-compose.yml (no defaults, MES-83).
#
# EASIEST LOCAL START: generate a `.env` of strong random values in one step:
#     ./scripts/gen-dev-secrets.sh
# Then `docker compose up --build -d`. Do NOT copy guessable passwords from this
# file — the values below are placeholders showing WHICH variables to set.
#
# LOCAL DEVELOPMENT ONLY: the compose stack binds published ports to 127.0.0.1
# (reachable from this machine only) and runs MESH_AUTH_MODE=dev. For ANY
# non-local use you MUST set MESH_AUTH_MODE=production, provide real secrets,
# keep datastores off the public network, and enable protected-mode/TLS. The
# backend refuses empty / known-default / short credentials in production.

# PostgreSQL (docker compose service credentials)
MESH_POSTGRES_DB=mesh
MESH_POSTGRES_USER=mesh
# Strong random password (REQUIRED). Generate: openssl rand -base64 32
MESH_POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Redis password (compose requirepass + the MESH_REDIS_URL credentials the
# api/worker/gateway connect with). REQUIRED — an unauthenticated or
# guessable-password Redis is the MES-83 incident. Generate a strong value.
MESH_REDIS_PASSWORD=replace-with-a-strong-random-password

# Restricted non-owner DB role password for the API/gateway app connection (M1).
# Migration 0002 creates/updates the mesh_app login role with this password and
# compose wires MESH_APP_DATABASE_URL from it. REQUIRED, strong value.
MESH_APP_DB_PASSWORD=replace-with-a-strong-random-password

# Object storage (MinIO) root credentials. REQUIRED, strong values.
MESH_STORAGE_ACCESS_KEY=replace-with-an-access-key
MESH_STORAGE_SECRET_KEY=replace-with-a-strong-random-secret

# Host port mapping (published ports bind 127.0.0.1 — see docker-compose.yml).
MESH_API_PORT=8000
MESH_WS_PORT=8081
MESH_FRONTEND_PORT=3001

# Auth mode: dev = development token authenticator (mesh-dev:<workspace-id>);
# production refuses dev tokens (the auth module plugs in the real one).
# Safe as "dev" ONLY because ports are loopback-bound; set "production" for any
# non-local deployment.
MESH_AUTH_MODE=dev

# JWT signing secret for access tokens (also derives the at-rest MFA encryption
# key). A dev default is used when unset; production REFUSES the dev default —
# set a long random value, e.g.: python -c "import secrets;print(secrets.token_urlsafe(48))"
# MESH_JWT_SECRET=replace-with-a-long-random-secret

# OAuth dev mock provider redirect_uri allowlist (auth.md §1.2 A5/A6, M1):
# comma-separated EXACT-MATCH URIs the dev "mock" provider may redirect back to.
# Empty/unset disables the mock provider's redirect (start → 422
# redirect_uri_not_allowed). compose defaults this to the frontend dev server's
# callback (http://localhost:5173/auth/oauth/callback/mock and the 127.0.0.1
# spelling); production providers carry their own operator-configured allowlist.
# MESH_OAUTH_MOCK_REDIRECT_URIS=http://localhost:5173/auth/oauth/callback/mock

# Transactional email (verification / password-reset). In MESH_AUTH_MODE=dev the
# one-time tokens are stashed in a Redis dev-mailbox (test path). For production,
# configure a real SMTP server below; if MESH_SMTP_HOST is unset in production,
# email delivery is a logged no-op (the API still boots, but mail is not sent).
# MESH_SMTP_HOST=smtp.example.com
# MESH_SMTP_PORT=587
# MESH_SMTP_USERNAME=apikey
# MESH_SMTP_PASSWORD=replace-with-smtp-password
# MESH_SMTP_FROM=noreply@mesh.example.com
# MESH_SMTP_USE_TLS=true
# Base URL used to build verification/reset links in outgoing email.
# MESH_APP_BASE_URL=https://mesh.example.com

# Object storage for attachments (attachment.md §3). The bucket is PRIVATE —
# every access goes through short-lived presigned URLs; bytes never transit
# the API process. MESH_STORAGE_ENDPOINT is what the server process can reach
# (compose network default: http://minio:9000); MESH_STORAGE_PUBLIC_ENDPOINT
# is what browsers/CLIs can reach — presigned URLs are signed against it.
# MESH_STORAGE_ENDPOINT=http://minio:9000
# MESH_STORAGE_PUBLIC_ENDPOINT=http://127.0.0.1:9000
# MESH_STORAGE_REGION=us-east-1
# MESH_STORAGE_ACCESS_KEY=replace-with-access-key
# MESH_STORAGE_SECRET_KEY=replace-with-secret-key
# MESH_STORAGE_BUCKET=mesh-attachments
# Attachment limits (defaults: 100 MB per file / 25 MB images / 10 GB total).
# MESH_ATTACHMENT_MAX_FILE_BYTES=104857600
# MESH_ATTACHMENT_MAX_IMAGE_BYTES=26214400
# MESH_ATTACHMENT_TOTAL_BYTES=10737418240
# Skill imports (skill.md §5.3 / README §6.16): server-side source fetches are
# SSRF-guarded (public addresses only). To import from a private/intranet registry
# or a loopback fixture, list its hosts explicitly (comma-separated). Leave unset
# for the default public-only policy.
# MESH_SKILL_SOURCE_HOST_ALLOWLIST=registry.corp.example
# Optional external marketplace listings API consumed by the marketplace page
# (skill.md §1.3 — Mesh does not host a market). Unset = empty marketplace.
# MESH_SKILL_MARKETPLACE_URL=https://market.example.com
