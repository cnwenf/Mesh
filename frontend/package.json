{
  "name": "mesh-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "build": "npm run gen:tokens && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check:contrast": "node scripts/check-contrast.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/verify-perfile-coverage.mjs",
    "test:e2e": "playwright test",
    "serve:e2e": "npm run build && vite preview --port 5173 --strictPort --host 127.0.0.1",
    "test:e2e:visual": "playwright test -c playwright.visual.config.ts",
    "test:e2e:mes32": "playwright test -c playwright.mes32.config.ts",
    "test:e2e:runtimes": "playwright test -c playwright.runtimes.config.ts",
    "test:e2e:autopilots": "playwright test -c playwright.autopilots.config.ts",
    "test:e2e:mes129": "playwright test -c playwright.mes129.config.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "^7.0.4",
    "react-router": "^8.3.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.5.2",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "0.25.12",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  }
}
