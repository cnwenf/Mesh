{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "./stylelint-plugins/no-hardcoded-colors.mjs",
    "./stylelint-plugins/zindex-token-only.mjs"
  ],
  "ignoreFiles": [
    "src/design/tokens.css",
    "src/design/tokens-dark.css",
    "src/design/tokens-print.css",
    "src/design/skeleton.css"
  ],
  "rules": {
    "mesh/no-hardcoded-colors": true,
    "selector-class-pattern": null,
    "rule-empty-line-before": null,
    "no-descending-specificity": null,
    "media-feature-range-notation": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "no-duplicate-selectors": null,
    "value-keyword-case": null,
    "color-hex-length": null,
    "font-family-name-quotes": null,
    "alpha-value-notation": null,
    "import-notation": null,
    "mesh/zindex-token-only": true
  }
}
